# Firebase web app configuration. These values identify the Firebase web app;
# Firestore Security Rules protect the database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Netlify Functions only: use a server-compatible Firebase web key if the VITE key has referrer restrictions.
FIREBASE_WEB_API_KEY=
# Optional comma-separated additional allowed Mashrouak origins (for deployment previews).
PUBLIC_PROJECTS_ORIGINS=
