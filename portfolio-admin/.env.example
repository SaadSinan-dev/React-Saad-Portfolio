# Shared Firebase web app configuration (same Firebase project as the public portfolio)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned image uploads (no API secret in the frontend)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Public portfolio URL used by the "Back to portfolio" link
VITE_PUBLIC_PORTFOLIO_URL=

# SERVER ONLY: add in Netlify environment variables with Functions scope.
# Never prefix these with VITE_. Never commit populated values.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: same-project Firebase web API key suitable for server-side requests.
# Needed if VITE_FIREBASE_API_KEY has browser-referrer restrictions.
FIREBASE_WEB_API_KEY=
